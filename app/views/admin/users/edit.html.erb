<% content_for :title, "#{@user.name} - 編集" %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "管理画面", admin_root_path %></li>
    <li class="breadcrumb-item"><%= link_to "ユーザー管理", admin_users_path %></li>
    <li class="breadcrumb-item"><%= link_to @user.name, admin_user_path(@user) %></li>
    <li class="breadcrumb-item active">編集</li>
  </ol>
</nav>

<div class="page-header">
  <h1 class="page-title">ユーザー編集</h1>
</div>

<div class="card" style="max-width:540px;">
  <div class="card-body">
    <%= form_with model: [:admin, @user] do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger mb-3">
          <% @user.errors.full_messages.each do |msg| %>
            <div><%= msg %></div>
          <% end %>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, "氏名", class: "form-label fw-semibold" %>
        <%= f.text_field :name, class: "form-control #{'is-invalid' if @user.errors[:name].any?}" %>
        <div class="invalid-feedback"><%= @user.errors[:name].first %></div>
      </div>

      <div class="mb-3">
        <%= f.label :email, "メールアドレス", class: "form-label fw-semibold" %>
        <%= f.email_field :email, class: "form-control #{'is-invalid' if @user.errors[:email].any?}" %>
        <div class="invalid-feedback"><%= @user.errors[:email].first %></div>
      </div>

      <div class="mb-4">
        <%= f.label :role, "ロール", class: "form-label fw-semibold" %>
        <%= f.select :role,
              [["作業員", "worker"], ["管理者", "admin"]],
              {},
              class: "form-select" %>
        <div class="form-text">管理者に変更すると管理画面へのアクセスが付与されます</div>
      </div>

      <div class="d-flex gap-2">
        <%= link_to "キャンセル", admin_user_path(@user), class: "btn btn-outline-secondary" %>
        <%= f.submit "更新する", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
