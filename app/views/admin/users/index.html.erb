<% content_for :title, "ユーザー管理" %>

<div class="page-header">
  <h1 class="page-title">ユーザー管理</h1>
</div>

<div class="table-card d-none d-md-block">
  <table class="table">
    <thead>
      <tr>
        <th>氏名</th>
        <th>メールアドレス</th>
        <th>ロール</th>
        <th>日報数</th>
        <th>出張数</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="fw-semibold"><%= user.name %></td>
          <td class="text-muted"><%= user.email %></td>
          <td>
            <span class="badge-role-<%= user.role %>">
              <%= I18n.t("enums.user.role.#{user.role}", default: user.role) %>
            </span>
          </td>
          <td><%= user.inspections.count %></td>
          <td><%= user.business_trips.count %></td>
          <td class="text-end text-nowrap">
            <%= link_to "詳細", admin_user_path(user), class: "btn btn-sm btn-outline-primary me-1" %>
            <%= link_to "編集", edit_admin_user_path(user), class: "btn btn-sm btn-outline-secondary me-1" %>
            <% unless user == current_user %>
              <%= button_to "削除", admin_user_path(user), method: :delete,
                    data: { turbo_confirm: "「#{user.name}」を削除しますか？\n関連する日報・出張報告もすべて削除されます。" },
                    class: "btn btn-sm btn-outline-danger" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="card d-block d-md-none">
  <% @users.each do |user| %>
    <div class="mobile-list-item">
      <div style="flex:1; min-width:0;">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-semibold" style="font-size:.9rem; color:#1a3a5c;"><%= user.name %></span>
          <span class="badge-role-<%= user.role %>">
            <%= I18n.t("enums.user.role.#{user.role}", default: user.role) %>
          </span>
        </div>
        <div style="font-size:.83rem; color:#475569;"><%= user.email %></div>
        <div class="d-flex gap-3 mt-1" style="font-size:.77rem; color:#94a3b8;">
          <span>日報 <%= user.inspections.count %>件</span>
          <span>出張 <%= user.business_trips.count %>件</span>
        </div>
        <div class="d-flex gap-2 mt-3">
          <%= link_to "詳細", admin_user_path(user), class: "btn btn-sm btn-outline-primary" %>
          <%= link_to "編集", edit_admin_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
          <% unless user == current_user %>
            <%= button_to "削除", admin_user_path(user), method: :delete,
                  data: { turbo_confirm: "「#{user.name}」を削除しますか？\n関連する日報・出張報告もすべて削除されます。" },
                  class: "btn btn-sm btn-outline-danger",
                  form: { class: "flex-fill" } %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
