<%= form_with model: [@site, @business_trip], multipart: true do |f| %>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :started_at, "出発日", class: "form-label fw-semibold" %>
      <%= f.date_field :started_at,
            class: "form-control #{'is-invalid' if @business_trip.errors[:started_at].any?}" %>
      <div class="invalid-feedback"><%= @business_trip.errors[:started_at].first %></div>
    </div>
    <div class="col-md-6">
      <%= f.label :ended_at, "帰着日", class: "form-label fw-semibold" %>
      <%= f.date_field :ended_at,
            class: "form-control #{'is-invalid' if @business_trip.errors[:ended_at].any?}" %>
      <div class="invalid-feedback"><%= @business_trip.errors[:ended_at].first %></div>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :destination, "出張先", class: "form-label fw-semibold" %>
    <%= f.text_field :destination,
          class: "form-control #{'is-invalid' if @business_trip.errors[:destination].any?}",
          placeholder: "例：大阪府大阪市" %>
    <div class="invalid-feedback"><%= @business_trip.errors[:destination].first %></div>
  </div>

  <div class="mb-3">
    <%= f.label :purpose, "目的", class: "form-label fw-semibold" %>
    <%= f.text_area :purpose,
          class: "form-control #{'is-invalid' if @business_trip.errors[:purpose].any?}",
          rows: 3, placeholder: "出張の目的・内容を記入してください" %>
    <div class="invalid-feedback"><%= @business_trip.errors[:purpose].first %></div>
  </div>

  <div class="mb-3">
    <%= f.label :report, "報告内容", class: "form-label fw-semibold" %>
    <%= f.text_area :report, class: "form-control", rows: 4,
          placeholder: "出張の結果・成果・所感など" %>
  </div>

  <div class="mb-3">
    <%= f.label :expenses, "経費（円）", class: "form-label fw-semibold" %>
    <%= f.number_field :expenses, class: "form-control", placeholder: "0", step: 1, min: 0 %>
  </div>

  <%# 編集時：添付済みファイル一覧 %>
  <% if !@business_trip.new_record? && @business_trip.files.attached? %>
    <div class="mb-3">
      <label class="form-label fw-semibold">添付済みファイル</label>
      <div class="border rounded p-3" style="background:#f8fafc;">
        <% @business_trip.files.each do |file| %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="form-check mb-0">
              <%= check_box_tag "remove_file_ids[]", file.id, false,
                    id: "remove_file_#{file.id}", class: "form-check-input" %>
              <label class="form-check-label d-flex align-items-center gap-1" for="remove_file_<%= file.id %>">
                <span><%= file.content_type.start_with?("image/") ? "🖼" : "📄" %></span>
                <span class="small"><%= file.filename %></span>
                <span class="text-muted small">(<%= number_to_human_size(file.byte_size) %>)</span>
              </label>
            </div>
          </div>
        <% end %>
        <div class="form-text text-danger mt-1">チェックしたファイルは更新時に削除されます</div>
      </div>
    </div>
  <% end %>

  <%# ファイル添付 %>
  <div class="mb-3">
    <%= f.label :files, "ファイル添付", class: "form-label fw-semibold" %>
    <%= f.file_field :files, multiple: true,
          accept: "image/jpeg,image/png,image/gif,image/webp,application/pdf",
          class: "form-control #{'is-invalid' if @business_trip.errors[:files].any?}" %>
    <% if @business_trip.errors[:files].any? %>
      <div class="invalid-feedback d-block"><%= @business_trip.errors[:files].join("、") %></div>
    <% end %>
    <div class="form-text">最大10個・1ファイル20MB以内・JPEG・PNG・GIF・WebP・PDFのみ可</div>
  </div>

  <% if @business_trip.new_record? %>
    <div class="mb-4 p-3 rounded" style="background:#f0f4f8; border:1.5px dashed #cbd5e1;">
      <div class="d-flex align-items-center gap-2 mb-2">
        <span style="font-size:1.1rem;">📧</span>
        <span class="fw-semibold" style="font-size:.9rem;">メール通知（任意）</span>
      </div>
      <label class="form-label small text-muted mb-1">登録ユーザーから選択</label>
      <div class="d-flex flex-column gap-2 mb-3">
        <% @users.each do |user| %>
          <div class="form-check notify-check-item">
            <%= check_box_tag "business_trip[notify_emails][]", user.email, false,
                  id: "business_trip_notify_#{user.id}",
                  class: "form-check-input" %>
            <label class="form-check-label" for="business_trip_notify_<%= user.id %>">
              <span class="fw-semibold"><%= user.name %></span>
              <span class="text-muted small ms-1"><%= user.email %></span>
            </label>
          </div>
        <% end %>
      </div>
      <label class="form-label small text-muted mb-1">その他（メールアドレスを直接入力）</label>
      <%= text_field_tag "business_trip[notify_emails][]", nil,
            class: "form-control",
            placeholder: "例：manager@example.com",
            type: "email" %>
      <div class="form-text mt-1">チェック・入力したアドレスに通知メールを送信します</div>
    </div>
  <% end %>

  <div class="d-flex gap-2">
    <%= link_to "キャンセル",
          @business_trip.new_record? ? site_business_trips_path(@site) : site_business_trip_path(@site, @business_trip),
          class: "btn btn-outline-secondary" %>
    <%= f.submit @business_trip.new_record? ? "登録する" : "更新する", class: "btn btn-primary" %>
  </div>
<% end %>
