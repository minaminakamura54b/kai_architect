<% content_for :title, "出張報告一覧 - #{@site.name}" %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "現場一覧", sites_path %></li>
    <li class="breadcrumb-item"><%= link_to @site.name, @site %></li>
    <li class="breadcrumb-item active">出張報告</li>
  </ol>
</nav>

<div class="page-header">
  <h1 class="page-title">🚗 出張報告 — <%= @site.name %></h1>
  <%= link_to "＋ 出張報告を追加", new_site_business_trip_path(@site), class: "btn btn-accent" %>
</div>

<% if @business_trips.any? %>
  <%# デスクトップ: テーブル表示 %>
  <div class="table-card d-none d-md-block">
    <table class="table">
      <thead>
        <tr>
          <th>期間</th>
          <th>担当者</th>
          <th>出張先</th>
          <th>目的</th>
          <th>経費</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @business_trips.each do |trip| %>
          <tr>
            <td class="text-nowrap fw-semibold"><%= l trip.started_at, format: :short %> 〜 <%= l trip.ended_at, format: :short %></td>
            <td class="text-nowrap"><%= trip.user.name %></td>
            <td class="td-truncate-sm"><%= trip.destination %></td>
            <td class="td-truncate"><%= trip.purpose %></td>
            <td class="text-nowrap"><%= trip.expenses ? "#{number_with_delimiter(trip.expenses.to_i)}円" : "—" %></td>
            <td class="text-end text-nowrap">
              <%= link_to "詳細", site_business_trip_path(@site, trip), class: "btn btn-sm btn-outline-primary me-1" %>
              <%= link_to "編集", edit_site_business_trip_path(@site, trip), class: "btn btn-sm btn-outline-secondary me-1" %>
              <%= button_to "削除", site_business_trip_path(@site, trip), method: :delete,
                    data: { turbo_confirm: "削除しますか？" },
                    class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# モバイル: カード形式 %>
  <div class="card d-block d-md-none">
    <% @business_trips.each do |trip| %>
      <div class="mobile-list-item">
        <div style="flex:1; min-width:0;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-semibold text-truncate" style="font-size:.9rem; color:#1a3a5c;"><%= trip.destination %></span>
            <span class="text-muted flex-shrink-0 ms-2" style="font-size:.78rem;">
              <%= l trip.started_at, format: :short %> 〜 <%= l trip.ended_at, format: :short %>
            </span>
          </div>
          <div class="text-truncate" style="font-size:.83rem; color:#475569;"><%= truncate(trip.purpose, length: 50) %></div>
          <div class="d-flex gap-3 mt-1" style="font-size:.77rem; color:#94a3b8;">
            <span><%= trip.user.name %></span>
            <% if trip.expenses.present? && trip.expenses > 0 %>
              <span><%= number_with_delimiter(trip.expenses.to_i) %>円</span>
            <% end %>
          </div>
          <div class="d-flex gap-2 mt-3">
            <%= link_to "詳細", site_business_trip_path(@site, trip), class: "btn btn-sm btn-outline-primary" %>
            <%= link_to "編集", edit_site_business_trip_path(@site, trip), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "削除", site_business_trip_path(@site, trip), method: :delete,
                  data: { turbo_confirm: "削除しますか？" },
                  class: "btn btn-sm btn-outline-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="pagination-wrapper">
    <%= will_paginate @business_trips %>
  </div>
<% else %>
  <div class="card">
    <div class="empty-state">
      <div class="empty-icon">🚗</div>
      <p>出張報告がありません</p>
      <%= link_to "最初の出張報告を追加", new_site_business_trip_path(@site), class: "btn btn-accent" %>
    </div>
  </div>
<% end %>
