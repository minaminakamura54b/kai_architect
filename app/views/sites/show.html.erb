<% content_for :title, @site.name %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "現場一覧", sites_path %></li>
    <li class="breadcrumb-item active"><%= @site.name %></li>
  </ol>
</nav>

<div class="page-header">
  <div class="d-flex align-items-center gap-3 flex-wrap">
    <h1 class="page-title"><%= @site.name %></h1>
    <span class="badge badge-site-<%= @site.status %> fs-6">
      <%= I18n.t("enums.site.status.#{@site.status}", default: @site.status) %>
    </span>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "編集", edit_site_path(@site), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "削除", @site, method: :delete,
          data: { turbo_confirm: "「#{@site.name}」を削除しますか？" },
          class: "btn btn-outline-danger btn-sm" %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <p class="mb-1 text-muted small">📍 <%= @site.address %></p>
    <% if @site.description.present? %>
      <p class="mb-0 mt-2"><%= @site.description %></p>
    <% end %>
  </div>
</div>

<!-- 日報 -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="section-title">📋 日報</span>
  <%= link_to "＋ 追加", new_site_inspection_path(@site), class: "btn btn-sm btn-accent" %>
</div>

<% if @site.inspections.any? %>
  <%# デスクトップ %>
  <div class="table-card mb-3 d-none d-md-block">
    <table class="table">
      <thead>
        <tr>
          <th>報告日時</th>
          <th>発信者</th>
          <th>結果概要</th>
          <th>ステータス</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @site.inspections.order(inspected_at: :desc).limit(5).each do |inspection| %>
          <tr>
            <td class="text-nowrap fw-semibold"><%= l inspection.inspected_at, format: :short %></td>
            <td class="text-nowrap"><%= inspection.user.name %></td>
            <td class="td-truncate"><%= inspection.result %></td>
            <td>
              <span class="badge-<%= inspection.status %>">
                <%= I18n.t("enums.inspection.status.#{inspection.status}", default: inspection.status) %>
              </span>
            </td>
            <td class="text-end text-nowrap">
              <%= link_to "詳細", site_inspection_path(@site, inspection), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%# モバイル %>
  <div class="card mb-3 d-block d-md-none">
    <% @site.inspections.order(inspected_at: :desc).limit(5).each do |inspection| %>
      <%= link_to site_inspection_path(@site, inspection), class: "mobile-list-item text-decoration-none" do %>
        <div style="flex:1; min-width:0;">
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge-<%= inspection.status %> flex-shrink-0">
              <%= I18n.t("enums.inspection.status.#{inspection.status}", default: inspection.status) %>
            </span>
            <span class="text-muted" style="font-size:.78rem;"><%= l inspection.inspected_at, format: :short %></span>
          </div>
          <div class="text-truncate fw-semibold" style="font-size:.9rem; color:#1a3a5c;"><%= truncate(inspection.result, length: 50) %></div>
          <div class="mt-1" style="font-size:.77rem; color:#94a3b8;"><%= inspection.user.name %></div>
        </div>
      <% end %>
    <% end %>
  </div>
  <%= link_to "すべての日報を見る →", site_inspections_path(@site), class: "text-primary-custom fw-semibold small" %>
<% else %>
  <div class="card mb-4">
    <div class="empty-state" style="padding:2rem;">
      <p class="mb-2 text-muted small">日報がありません</p>
    </div>
  </div>
<% end %>

<hr class="my-4">

<!-- 出張報告 -->
<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
  <span class="section-title">🚗 出張報告</span>
  <%= link_to "＋ 追加", new_site_business_trip_path(@site), class: "btn btn-sm btn-accent" %>
</div>

<% if @site.business_trips.any? %>
  <%# デスクトップ %>
  <div class="table-card mb-3 d-none d-md-block">
    <table class="table">
      <thead>
        <tr>
          <th>期間</th>
          <th>担当者</th>
          <th>出張先</th>
          <th>目的</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @site.business_trips.order(started_at: :desc).limit(5).each do |trip| %>
          <tr>
            <td class="text-nowrap fw-semibold"><%= l trip.started_at, format: :short %> 〜 <%= l trip.ended_at, format: :short %></td>
            <td class="text-nowrap"><%= trip.user.name %></td>
            <td class="td-truncate-sm"><%= trip.destination %></td>
            <td class="td-truncate"><%= trip.purpose %></td>
            <td class="text-end text-nowrap">
              <%= link_to "詳細", site_business_trip_path(@site, trip), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%# モバイル %>
  <div class="card mb-3 d-block d-md-none">
    <% @site.business_trips.order(started_at: :desc).limit(5).each do |trip| %>
      <%= link_to site_business_trip_path(@site, trip), class: "mobile-list-item text-decoration-none" do %>
        <div style="flex:1; min-width:0;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-semibold text-truncate" style="font-size:.9rem; color:#1a3a5c;"><%= trip.destination %></span>
            <span class="text-muted flex-shrink-0 ms-2" style="font-size:.78rem;">
              <%= l trip.started_at, format: :short %> 〜 <%= l trip.ended_at, format: :short %>
            </span>
          </div>
          <div class="text-truncate" style="font-size:.83rem; color:#475569;"><%= truncate(trip.purpose, length: 50) %></div>
          <div class="mt-1" style="font-size:.77rem; color:#94a3b8;"><%= trip.user.name %></div>
        </div>
      <% end %>
    <% end %>
  </div>
  <%= link_to "すべての出張報告を見る →", site_business_trips_path(@site), class: "text-primary-custom fw-semibold small" %>
<% else %>
  <div class="card">
    <div class="empty-state" style="padding:2rem;">
      <p class="mb-2 text-muted small">出張報告がありません</p>
    </div>
  </div>
<% end %>
