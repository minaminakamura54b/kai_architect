<%= form_with model: [@site, @inspection], multipart: true do |f| %>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :inspected_at, "報告日時", class: "form-label fw-semibold" %>
      <%= f.datetime_local_field :inspected_at,
            class: "form-control #{'is-invalid' if @inspection.errors[:inspected_at].any?}" %>
      <div class="invalid-feedback"><%= @inspection.errors[:inspected_at].first %></div>
    </div>
    <div class="col-md-6">
      <%= f.label :status, "ステータス", class: "form-label fw-semibold" %>
      <%= f.select :status,
            [["未着手", "not_started"], ["継続中", "in_progress"], ["完了", "completed"]],
            {},
            class: "form-select" %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :result, "報告内容", class: "form-label fw-semibold" %>
    <%= f.text_area :result,
          class: "form-control #{'is-invalid' if @inspection.errors[:result].any?}",
          rows: 5, placeholder: "点検内容・確認事項・問題点などを記入してください" %>
    <div class="invalid-feedback"><%= @inspection.errors[:result].first %></div>
  </div>

  <div class="mb-3">
    <%= f.label :remarks, "備考", class: "form-label fw-semibold" %>
    <%= f.text_area :remarks, class: "form-control", rows: 3,
          placeholder: "補足事項・次回対応事項など" %>
  </div>

  <%# 編集時：添付済みファイル一覧 %>
  <% if !@inspection.new_record? && @inspection.files.attached? %>
    <div class="mb-3">
      <label class="form-label fw-semibold">添付済みファイル</label>
      <div class="border rounded p-3" style="background:#f8fafc;">
        <% @inspection.files.each do |file| %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="form-check mb-0">
              <%= check_box_tag "remove_file_ids[]", file.id, false,
                    id: "remove_file_#{file.id}", class: "form-check-input" %>
              <label class="form-check-label d-flex align-items-center gap-1" for="remove_file_<%= file.id %>">
                <span><%= file.content_type.start_with?("image/") ? "🖼" : "📄" %></span>
                <span class="small"><%= file.filename %></span>
                <span class="text-muted small">(<%= number_to_human_size(file.byte_size) %>)</span>
              </label>
            </div>
          </div>
        <% end %>
        <div class="form-text text-danger mt-1">チェックしたファイルは更新時に削除されます</div>
      </div>
    </div>
  <% end %>

  <%# ファイル添付 %>
  <div class="mb-3">
    <%= f.label :files, "ファイル添付", class: "form-label fw-semibold" %>
    <%= f.file_field :files, multiple: true,
          accept: "image/jpeg,image/png,image/gif,image/webp,application/pdf",
          capture: "environment",
          class: "form-control #{'is-invalid' if @inspection.errors[:files].any?}" %>
    <% if @inspection.errors[:files].any? %>
      <div class="invalid-feedback d-block"><%= @inspection.errors[:files].join("、") %></div>
    <% end %>
    <div class="form-text">最大10個・1ファイル20MB以内・JPEG・PNG・GIF・WebP・PDFのみ可</div>
  </div>

  <% if @inspection.new_record? %>
    <div class="mb-4 p-3 rounded" style="background:#f0f4f8; border:1.5px dashed #cbd5e1;">
      <div class="d-flex align-items-center gap-2 mb-2">
        <span style="font-size:1.1rem;">📧</span>
        <span class="fw-semibold" style="font-size:.9rem;">メール通知（任意）</span>
      </div>
      <label class="form-label small text-muted mb-1">登録ユーザーから選択</label>
      <div class="d-flex flex-column gap-2 mb-3">
        <% @users.each do |user| %>
          <div class="form-check notify-check-item">
            <%= check_box_tag "inspection[notify_emails][]", user.email, false,
                  id: "inspection_notify_#{user.id}",
                  class: "form-check-input" %>
            <label class="form-check-label" for="inspection_notify_<%= user.id %>">
              <span class="fw-semibold"><%= user.name %></span>
              <span class="text-muted small ms-1"><%= user.email %></span>
            </label>
          </div>
        <% end %>
      </div>
      <label class="form-label small text-muted mb-1">その他（メールアドレスを直接入力）</label>
      <%= text_field_tag "inspection[notify_emails][]", nil,
            class: "form-control",
            placeholder: "例：manager@example.com",
            type: "email" %>
      <div class="form-text mt-1">チェック・入力したアドレスに通知メールを送信します</div>
    </div>
  <% end %>

  <div class="d-flex gap-2">
    <%= link_to "キャンセル", site_inspections_path(@site), class: "btn btn-outline-secondary" %>
    <%= f.submit @inspection.new_record? ? "記録する" : "更新する", class: "btn btn-primary" %>
  </div>
<% end %>
