<% content_for :title, "日報一覧 - #{@site.name}" %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "現場一覧", sites_path %></li>
    <li class="breadcrumb-item"><%= link_to @site.name, @site %></li>
    <li class="breadcrumb-item active">日報</li>
  </ol>
</nav>

<div class="page-header">
  <h1 class="page-title">📋 <%= @site.name %></h1>
  <%= link_to "＋ 日報を追加", new_site_inspection_path(@site), class: "btn btn-accent" %>
</div>

<% if @inspections.any? %>
  <%# デスクトップ: テーブル表示 %>
  <div class="table-card d-none d-md-block">
    <table class="table">
      <thead>
        <tr>
          <th>報告日時</th>
          <th>発信者</th>
          <th>結果概要</th>
          <th>備考</th>
          <th>ステータス</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @inspections.each do |inspection| %>
          <tr>
            <td class="text-nowrap fw-semibold"><%= l inspection.inspected_at, format: :short %></td>
            <td class="text-nowrap"><%= inspection.user.name %></td>
            <td class="td-truncate"><%= inspection.result %></td>
            <td class="td-truncate-sm text-muted small"><%= inspection.remarks %></td>
            <td class="text-nowrap">
              <span class="badge-<%= inspection.status %>">
                <%= I18n.t("enums.inspection.status.#{inspection.status}", default: inspection.status) %>
              </span>
            </td>
            <td class="text-end text-nowrap">
              <%= link_to "詳細", site_inspection_path(@site, inspection), class: "btn btn-sm btn-outline-primary me-1" %>
              <% if can_edit?(inspection) %>
                <%= link_to "編集", edit_site_inspection_path(@site, inspection), class: "btn btn-sm btn-outline-secondary me-1" %>
                <%= button_to "削除", site_inspection_path(@site, inspection), method: :delete,
                      data: { turbo_confirm: "削除しますか？" },
                      class: "btn btn-sm btn-outline-danger" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# モバイル: カード形式 %>
  <div class="card d-block d-md-none">
    <% @inspections.each do |inspection| %>
      <div class="mobile-list-item">
        <div class="d-flex align-items-start gap-2 mb-2">
          <span class="badge-<%= inspection.status %> flex-shrink-0">
            <%= I18n.t("enums.inspection.status.#{inspection.status}", default: inspection.status) %>
          </span>
          <span class="text-muted" style="font-size:.78rem; padding-top:.15rem;"><%= l inspection.inspected_at, format: :short %></span>
        </div>
        <div class="text-truncate fw-semibold" style="font-size:.9rem; color:#1a3a5c;"><%= truncate(inspection.result, length: 50) %></div>
        <% if inspection.remarks.present? %>
          <div class="text-truncate mt-1" style="font-size:.8rem; color:#64748b;"><%= truncate(inspection.remarks, length: 40) %></div>
        <% end %>
        <div class="mt-1" style="font-size:.77rem; color:#94a3b8;"><%= inspection.user.name %></div>
        <div class="d-flex gap-2 mt-3">
          <%= link_to "詳細", site_inspection_path(@site, inspection), class: "btn btn-sm btn-outline-primary" %>
          <% if can_edit?(inspection) %>
            <%= link_to "編集", edit_site_inspection_path(@site, inspection), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "削除", site_inspection_path(@site, inspection), method: :delete,
                  data: { turbo_confirm: "削除しますか？" },
                  class: "btn btn-sm btn-outline-danger",
                  form: { class: "flex-fill" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="pagination-wrapper">
    <%= will_paginate @inspections %>
  </div>
<% else %>
  <div class="card">
    <div class="empty-state">
      <div class="empty-icon">🔍</div>
      <p>日報がありません</p>
      <%= link_to "最初の日報を記録する", new_site_inspection_path(@site), class: "btn btn-accent" %>
    </div>
  </div>
<% end %>
